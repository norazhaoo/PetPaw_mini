/* pages/dashboard/dashboard.wxss */

/* Unified section layout */
.section-block {
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Pill scroll shared by Stock Alert and Things to Track */
.pill-scroll {
  white-space: nowrap;
}

.pill-row {
  display: inline-flex;
  gap: 24rpx;
  padding-bottom: 8rpx;
  padding-top: 10rpx;
}

/* Each pill: icon circle + value + label stacked vertically */
.pill-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  min-width: 112rpx;
}

.pill-item-wrap {
  display: inline-flex;
  position: relative;
  flex-shrink: 0;
}

.pill-item-wrap.dragging {
  z-index: 3;
}

.pill-item-wrap.dragging .pill-item {
  transform: scale(1.06);
  opacity: 0.88;
}

.pill-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0EDE6;
}

.pill-value {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-main);
  line-height: 1;
  height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 140rpx;
  display: flex;
  align-items: center;
}

.pill-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  white-space: nowrap;
}

.pill-delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  background: transparent;
}

.pill-item.hidden-item {
  opacity: 0.4;
  filter: grayscale(1);
}

.pill-delete-btn.hidden-item {
  background: rgba(0,0,0,0.1);
}

/* Diary view switch */
.diary-view-switch {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--card-bg);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}

.diary-view-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-muted);
}

.diary-view-tab-active {
  background: var(--primary);
  color: var(--text-main);
}

/* iOS Wiggle / Shake animation for edit mode */
@keyframes wiggle {
  0% { transform: rotate(-1.5deg); }
  50% { transform: rotate(1.5deg); }
  100% { transform: rotate(-1.5deg); }
}

.edit-mode .pill-icon-wrap {
  animation: wiggle 0.25s infinite ease-in-out;
  border: 2rpx solid var(--primary);
}

/* Today records */
.today-log-card {
  gap: 24rpx;
}

.today-log-title {
  font-size: 32rpx;
  margin: 0;
}

.today-empty {
  min-height: 180rpx;
  border-radius: 28rpx;
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.journal-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(245, 176, 65, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.journal-notebook-subtitle,
.journal-modal-date {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
}

.log-detail {
  font-size: 22rpx;
  line-height: 1.35;
  margin-top: 4rpx;
  max-width: 420rpx;
}

.journal-timeline-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.journal-notebook-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 4rpx 0;
}

.journal-notebook-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.journal-notebook-add {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.journal-filter-scroll {
  white-space: nowrap;
}

.journal-filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0 10rpx;
}

.journal-filter-chip {
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #FFF8E1;
  border: 2rpx solid #F5E6B8;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.journal-filter-chip-active {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--text-main);
  box-shadow: var(--shadow-button);
}

.journal-empty {
  min-height: 300rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.journal-date-groups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.journal-date-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.journal-date-group-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 4rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.journal-date-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
}

.journal-date-entries {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.journal-note-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 2rpx solid rgba(224, 218, 202, 0.55);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.journal-note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.journal-note-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-main);
  line-height: 1.35;
}

.journal-note-actions,
.journal-detail-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.journal-note-action,
.journal-detail-action {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255, 248, 225, 0.72);
  border: 2rpx solid rgba(245, 230, 184, 0.86);
}

.journal-note-delete {
  background: rgba(255, 244, 239, 0.82);
}

.journal-note-date {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(74, 64, 58, 0.48);
}

.journal-note-preview {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-muted);
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.journal-note-image {
  width: 100%;
  border-radius: 24rpx;
  background: var(--bg-color);
}

.journal-image-landscape {
  height: 240rpx;
}

.journal-image-square {
  height: 320rpx;
}

.journal-image-portrait {
  height: 400rpx;
}

.journal-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.journal-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #FFF8E1;
  border: 2rpx solid #F5E6B8;
  color: var(--text-main);
  font-size: 22rpx;
  font-weight: 800;
}

.journal-tag-pill-active {
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: var(--shadow-button);
}

.journal-tag-remove {
  font-size: 24rpx;
  line-height: 1;
  color: var(--text-muted);
}

.journal-modal-card {
  gap: 28rpx;
}

.journal-modal-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.journal-date-picker {
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E0DACA;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.journal-date-picker-label {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-muted);
}

.journal-date-picker-value {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--text-main);
}

.journal-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E0DACA;
  box-sizing: border-box;
  background: #fff;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.5;
}

.journal-mood-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.journal-mood-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #FFF8E1;
  border: 2rpx solid #F5E6B8;
  color: var(--text-main);
  font-size: 24rpx;
  font-weight: 800;
}

.journal-mood-pill-active {
  background: linear-gradient(135deg, #FF7B54 0%, #F5B041 100%);
  border-color: #FF7B54;
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(255, 123, 84, 0.26);
}

.journal-mood-selected-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: #FF7B54;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.journal-custom-tag-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.journal-custom-tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.journal-custom-tag-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  border: 2rpx solid #E0DACA;
  box-sizing: border-box;
  background: #fff;
  color: var(--text-main);
  font-size: 26rpx;
}

.journal-custom-tag-add {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: var(--primary);
  color: var(--text-main);
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.journal-photo-placeholder {
  height: 120rpx;
  border: 4rpx dashed #E0DACA;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 800;
  background: #FFFDF2;
}

.journal-photo-preview {
  position: relative;
  width: 100%;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.journal-photo-img {
  width: 100%;
  height: 100%;
}

.journal-photo-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.52);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.journal-detail-card {
  gap: 24rpx;
  max-height: 80vh;
}

.journal-detail-image {
  width: 100%;
  max-height: 520rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.journal-detail-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.6;
  max-height: 420rpx;
  overflow: auto;
}

/* Monthly poster CTA */
.monthly-poster-card {
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.poster-card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(254, 225, 64, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.poster-card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-main);
}

.poster-card-subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.poster-card-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--text-main);
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.export-preview-overlay {
  flex-direction: column;
  background: rgba(0, 0, 0, 0.85);
  z-index: 2000;
}

.export-preview-scroll {
  width: 100%;
  flex: 1;
  height: 0;
}

.export-preview-content {
  padding: 60rpx 40rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.export-preview-image {
  width: 100%;
  border-radius: 32rpx;
  box-shadow: 0 40rpx 100rpx rgba(0, 0, 0, 0.6);
}

.export-preview-tip {
  color: #FFFFFF;
  font-size: 24rpx;
  margin-top: 32rpx;
  opacity: 0.6;
}

.export-preview-actions {
  width: 100%;
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.export-preview-actions button {
  flex: 1;
}

.export-preview-close,
.export-preview-save {
  border-radius: 32rpx;
}

.export-preview-close {
  border: 4rpx solid #F0EDE6;
}

.export-preview-save {
  background: var(--primary);
  color: #4A403A;
}

/* Calendar */
.today-btn {
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: var(--text-main);
  font-weight: 700;
  font-size: 22rpx;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  text-align: center;
}

.cal-header {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-muted);
}

.cal-weekday {
  text-align: center;
}

.cal-cell {
  min-height: 80rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-selected {
  border-color: var(--primary);
}

.cal-today {
  background: #FFFDF2;
}

.cal-day-num {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-main);
}

.cal-today-num {
  color: var(--warning);
  font-weight: 900;
}

.cal-icons {
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  margin-top: 4rpx;
  min-height: 22rpx;
  width: 100%;
  overflow: hidden;
}

.cal-icon-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 0 2rpx #fff;
}

.cal-icon-dot + .cal-icon-dot {
  margin-left: -6rpx;
}

/* Stats */
.stat-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F0EDE6;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
}

.stat-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Log items */
.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
}

.log-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Modal extras */
.icon-select-btn {
  border: 4rpx solid transparent;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F0EDE6;
  flex-shrink: 0;
}

.icon-select-active {
  border-color: var(--text-main);
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.color-dot-active {
  border-color: var(--text-main);
}

.stats-rule-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0EDE6;
  color: var(--text-main);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.stats-rules-overlay {
  z-index: 2500;
}

.stats-rules-card {
  gap: 28rpx;
}

.stats-rule-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0EDE6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 40rpx;
  line-height: 1;
}

.stats-rule-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.55;
}
