<!-- pages/dashboard/dashboard.wxml -->
<wxs src="../../utils/icons.wxs" module="ic" />

<view class="app-container" wx:if="{{activePet}}">
  <!-- Header -->
  <view class="header-card">
    <image wx:if="{{activePet.avatar}}" class="header-avatar" src="{{activePet.avatar}}" mode="aspectFill" />
    <view wx:else class="header-avatar-placeholder">
      <text>{{activePet.species === 'dog' ? '🐶' : activePet.species === 'other' ? '🐾' : '🐱'}}</text>
    </view>
    <view class="flex-col">
      <text style="font-size:52rpx;font-weight:900;color:var(--text-main);letter-spacing:-1rpx;line-height:1.2;">{{activePet.name}}</text>
      <text style="font-size:26rpx;font-weight:700;color:var(--text-muted);">{{activePet.breed || (activePet.species === 'dog' ? i18n.dog : activePet.species === 'cat' ? i18n.cat : i18n.pawfile)}}</text>
    </view>
  </view>

  <!-- Stock Alert -->
  <view class="section-block">
    <text class="section-title">{{i18n.stock_alert}}</text>
    <scroll-view scroll-x="true" class="pill-scroll">
      <view class="pill-row">
        <view class="pill-item" wx:for="{{inventoryItems}}" wx:key="id">
          <view class="pill-icon-wrap" style="background:{{item.isLow ? '#FDEBD0' : item.color + '22'}};">
            <image class="icon-img" lazy-load style="width:56rpx;height:56rpx; opacity:0.65;" src="{{ic.src(item.iconName || 'Package')}}" mode="aspectFit" />
          </view>
          <text class="pill-value" style="color:{{item.isLow ? '#E74C3C' : 'var(--text-main)'}};">{{item.daysLeft}}{{i18n.d}}</text>
          <text class="pill-label">{{item.shortLabel}}</text>
        </view>
        <view class="pill-item-wrap" wx:for="{{stockActionItems}}" wx:key="actionKey">
          <view class="pill-item">
            <view class="pill-icon-wrap" style="background:{{item.color}}22;">
              <image class="icon-img" lazy-load style="width:56rpx;height:56rpx;" src="{{ic.src(item.iconName)}}" mode="aspectFit" />
            </view>
            <text class="pill-value">{{item.lastActionText}}</text>
            <text class="pill-label">{{item.stockLabel}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Quick daily record -->
  <view class="section-block">
    <view class="flex-row justify-between align-center" style="margin-bottom: 8rpx;">
      <text class="section-title">{{i18n.today_check_in}}</text>
      <text wx:if="{{isEditingActions}}" class="text-primary font-bold" style="font-size:24rpx;padding:8rpx 16rpx;" bindtap="stopEditActions">{{i18n.done || 'Done'}}</text>
    </view>
    <scroll-view scroll-x="{{!dragActionKey}}" class="pill-scroll">
      <view class="pill-row {{isEditingActions ? 'edit-mode' : ''}}">
        <!-- Track actions -->
        <view
          class="pill-item-wrap {{dragActionKey === item.actionKey ? 'dragging' : ''}}"
          wx:for="{{trackActions}}"
          wx:key="actionKey"
          data-action-key="{{item.actionKey}}"
          data-index="{{index}}"
          bindtouchstart="onTrackActionTouchStart"
          bindtouchmove="onTrackActionTouchMove"
          bindtouchend="onTrackActionTouchEnd"
          bindtouchcancel="onTrackActionTouchEnd"
        >
          <view
            class="pill-item {{item.hidden ? 'hidden-item' : ''}}"
            bindtap="handleTrackAction"
            bindlongpress="startEditActions"
            data-source="track"
            data-action-key="{{item.actionKey}}"
            data-index="{{index}}"
            data-kind="{{item.actionKind}}"
            data-type="{{item.type}}"
            data-id="{{item.id}}"
            data-label="{{item.displayLabel}}"
            data-color="{{item.color}}"
            data-iconidx="{{item.iconIdx}}"
          >
            <view class="pill-icon-wrap" style="background:{{item.color}}22;">
              <image class="icon-img" lazy-load style="width:56rpx;height:56rpx;" src="{{ic.src(item.iconName)}}" mode="aspectFit" />
            </view>
            <text class="pill-label">{{item.displayLabel}}</text>
          </view>
          <view
            wx:if="{{isEditingActions}}"
            class="pill-delete-btn {{item.hidden ? 'hidden-item' : ''}}"
            catchtap="hideTrackAction"
            data-kind="{{item.actionKind}}"
            data-type="{{item.type}}"
            data-id="{{item.id}}"
            data-label="{{item.displayLabel}}"
          >
             <image class="icon-img" lazy-load style="width:36rpx;height:36rpx;" src="{{ic.src(item.actionKind === 'custom' ? 'XCircle' : (item.hidden ? 'Eye' : 'XCircle'))}}" mode="aspectFit" />
          </view>
        </view>

        <!-- Add custom -->
        <view class="pill-item" bindtap="openCustomModal">
          <view class="pill-icon-wrap" style="background:#F0EDE6;">
            <image class="icon-img" lazy-load style="width:48rpx;height:48rpx;" src="{{ic.src('Plus')}}" mode="aspectFit" />
          </view>
          <text class="pill-label" style="color:var(--text-muted);">{{i18n.custom}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- Feedback -->
    <text wx:if="{{feedback}}" class="feedback-text" style="margin-top:16rpx;color:{{feedbackColor || 'var(--success)'}};">{{feedback}}</text>
  </view>

  <!-- Diary view switch -->
  <view class="diary-view-switch">
    <view
      class="diary-view-tab {{activeDiaryView === 'calendar' ? 'diary-view-tab-active' : ''}}"
      bindtap="switchDiaryView"
      data-view="calendar"
    >
      {{i18n.calendar_view || '日历'}}
    </view>
    <view
      class="diary-view-tab {{activeDiaryView === 'notebook' ? 'diary-view-tab-active' : ''}}"
      bindtap="switchDiaryView"
      data-view="notebook"
    >
      {{i18n.journal_title}}
    </view>
  </view>

  <block wx:if="{{activeDiaryView === 'calendar'}}">
  <!-- Calendar -->
  <view class="card" wx:if="{{ready}}">
    <view class="flex-between" style="margin-bottom:32rpx;">
      <view bindtap="prevMonth" style="padding:16rpx;">
        <image class="icon-img" lazy-load style="width:48rpx;height:48rpx;" src="{{ic.src('ChevronLeft')}}" mode="aspectFit" />
      </view>
      <view class="flex-row gap-md align-center">
        <text class="h3" style="margin:0;">{{currentMonthLabel}}</text>
        <view class="today-btn" bindtap="goToday">{{i18n.today || 'Today'}}</view>
      </view>
      <view bindtap="nextMonth" style="padding:16rpx;">
        <image class="icon-img" lazy-load style="width:48rpx;height:48rpx;" src="{{ic.src('ChevronRight')}}" mode="aspectFit" />
      </view>
    </view>

    <view class="cal-grid cal-header">
      <text wx:for="{{weekdays}}" wx:key="*this" class="cal-weekday">{{item}}</text>
    </view>

    <view class="cal-grid" style="margin-top:16rpx;">
      <view wx:for="{{blanks}}" wx:key="*this" class="cal-cell"></view>
      <view
        wx:for="{{daysInMonth}}"
        wx:key="dateStr"
        class="cal-cell {{item.isSelected ? 'cal-selected' : ''}} {{item.isToday ? 'cal-today' : ''}}"
        bindtap="selectDate"
        data-date="{{item.dateStr}}"
      >
        <text class="cal-day-num {{item.isToday ? 'cal-today-num' : ''}}">{{item.dayNum}}</text>
        <view class="cal-icons">
          <view wx:for="{{item.icons}}" wx:for-item="ic2" wx:key="name" class="cal-icon-dot" style="background:{{ic2.color}}22;">
            <image class="icon-img" lazy-load style="width:16rpx;height:16rpx;" src="{{ic.src(ic2.name)}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Selected Day Logs -->
  <view class="card today-log-card" wx:if="{{ready}}">
    <text class="h2 today-log-title">{{listTitle}}</text>
    <view wx:if="{{combinedLogs.length === 0}}" class="today-empty">
      <text class="text-muted">{{emptyLogText || i18n.no_today_records}}</text>
    </view>
    <view class="flex-col gap-md" wx:else>
      <view wx:for="{{combinedLogs}}" wx:key="id" class="log-item">
        <view class="flex-row gap-md flex-1">
          <view class="log-icon-wrap" style="background:{{item.iconColor}}22;">
            <image class="icon-img" lazy-load style="width:48rpx;height:48rpx;" src="{{ic.src(item.iconName)}}" mode="aspectFit" />
          </view>
          <view class="flex-col">
            <text style="font-weight:700;font-size:26rpx;">{{item.label}}</text>
            <text class="text-muted" style="font-size:20rpx;">{{item.time}}</text>
            <text wx:if="{{item.detail}}" class="text-muted log-detail">{{item.detail}}</text>
          </view>
        </view>
        <view bindtap="deleteLog" data-id="{{item.id}}" data-typegroup="{{item.typeGroup}}">
          <image class="icon-img" lazy-load style="width:36rpx;height:36rpx;" src="{{ic.src('XCircle')}}" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- Monthly poster CTA -->
  <view class="card monthly-poster-card" bindtap="exportReport" wx:if="{{ready}}">
    <view class="poster-card-icon">
      <image class="icon-img" lazy-load style="width:44rpx;height:44rpx;" src="{{ic.src('FileText')}}" mode="aspectFit" />
    </view>
    <view class="flex-col flex-1">
      <view style="display:flex;align-items:center;gap:12rpx;margin-bottom:4rpx;">
        <text class="poster-card-title">{{i18n.monthly_care_poster}}</text>
        <view class="stats-rule-btn" style="width:44rpx;height:44rpx;font-size:24rpx;" catchtap="openStatsRules">?</view>
      </view>
      <text class="poster-card-subtitle">{{i18n.poster_cta_hint}}</text>
    </view>
    <view class="poster-card-action">
      <text>{{i18n.poster_view}}</text>
      <image class="icon-img" lazy-load style="width:32rpx;height:32rpx;" src="{{ic.src('ChevronRight')}}" mode="aspectFit" />
    </view>
  </view>
  </block>

  <block wx:if="{{activeDiaryView === 'notebook'}}">
    <view class="journal-timeline-card" wx:if="{{ready}}">
      <view class="journal-notebook-header">
        <view class="journal-notebook-copy">
          <text class="h2">{{i18n.journal_title}}</text>
          <text class="journal-notebook-subtitle">{{i18n.journal_notebook_hint}}</text>
        </view>
        <view class="journal-notebook-add" bindtap="openJournalModal">
          <image class="icon-img" lazy-load style="width:40rpx;height:40rpx;" src="{{ic.src('Plus')}}" mode="aspectFit" />
        </view>
      </view>

      <scroll-view scroll-x="true" class="journal-filter-scroll">
        <view class="journal-filter-row">
          <view
            wx:for="{{journalFilterOptions}}"
            wx:key="id"
            class="journal-filter-chip {{activeJournalFilter === item.id ? 'journal-filter-chip-active' : ''}}"
            bindtap="switchJournalFilter"
            data-filter="{{item.id}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{journalDateGroups.length === 0}}" class="journal-empty">
        <image class="icon-img" lazy-load style="width:80rpx;height:80rpx;" src="{{ic.src('Book')}}" mode="aspectFit" />
        <text class="text-muted">{{i18n.journal_empty}}</text>
      </view>

      <view wx:else class="journal-date-groups">
        <view wx:for="{{journalDateGroups}}" wx:for-item="group" wx:key="dateKey" class="journal-date-group">
          <view class="journal-date-group-title">
            <view class="journal-date-dot"></view>
            <text>{{group.label}}</text>
          </view>
          <view class="journal-date-entries">
            <view wx:for="{{group.entries}}" wx:for-item="entry" wx:key="id" class="journal-note-card" bindtap="openJournalDetail" data-id="{{entry.id}}">
              <view class="journal-note-header">
                <text class="journal-note-title">{{entry.title}}</text>
                <view class="journal-note-delete" catchtap="deleteJournalEntry" data-id="{{entry.id}}">
                  <image class="icon-img" lazy-load style="width:34rpx;height:34rpx;" src="{{ic.src('XCircle')}}" mode="aspectFit" />
                </view>
              </view>
              <image wx:if="{{entry.image}}" src="{{entry.image}}" mode="aspectFill" class="journal-note-image journal-image-{{entry.imageRatioClass}}" />
              <text wx:if="{{entry.preview}}" class="journal-note-preview">{{entry.preview}}</text>
              <view wx:if="{{entry.tagLabels.length > 0}}" class="journal-tag-row">
                <view wx:for="{{entry.tagLabels}}" wx:for-item="tag" wx:key="*this" class="journal-tag-pill">
                  <text>{{tag}}</text>
                </view>
              </view>
              <text class="journal-note-date">{{entry.dateFormatted}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- Custom Event Modal -->
  <view wx:if="{{showCustomModal}}" class="modal-overlay" catchtap="closeCustomModal">
    <view class="modal-content card" catchtap="noop">
      <text class="h3">{{i18n.new_custom_event}}</text>
      <input class="input-field" placeholder="{{i18n.custom_event_placeholder}}" value="{{customName}}" bindinput="onCustomNameInput" />

      <text class="font-bold" style="margin-top:24rpx;font-size:28rpx;">{{i18n.select_icon}}</text>
      <scroll-view scroll-x="true" style="margin-top:16rpx;">
        <view class="flex-row gap-md">
          <view wx:for="{{customIconNames}}" wx:key="*this" wx:for-index="idx"
            class="icon-select-btn {{customIconIdx === idx ? 'icon-select-active' : ''}}"
            bindtap="selectCustomIcon" data-idx="{{idx}}">
            <image class="icon-img" lazy-load style="width:48rpx;height:48rpx;" src="{{ic.src(item)}}" mode="aspectFit" />
          </view>
        </view>
      </scroll-view>

      <text class="font-bold" style="margin-top:32rpx;font-size:28rpx;">{{i18n.select_color}}</text>
      <view class="flex-row gap-md flex-wrap" style="margin-top:16rpx;">
        <view wx:for="{{colorOptions}}" wx:key="*this"
          class="color-dot {{customColor === item ? 'color-dot-active' : ''}}"
          style="background:{{item}};"
          bindtap="selectCustomColor" data-color="{{item}}">
        </view>
      </view>

      <view class="flex-row gap-md" style="margin-top:48rpx;">
        <button class="btn-secondary flex-1" bindtap="closeCustomModal">{{i18n.cancel}}</button>
        <button class="btn-primary flex-1" bindtap="saveCustomAction">{{i18n.save}}</button>
      </view>
    </view>
  </view>

  <!-- Weight Modal -->
  <view wx:if="{{showWeightModal}}" class="modal-overlay" catchtap="closeWeightModal">
    <view class="modal-content card" catchtap="noop">
      <text class="h3">{{i18n.log_weight}}</text>
      <view class="flex-row gap-lg align-center" style="margin:40rpx 0;">
        <slider min="5" max="300" value="{{newWeight * 10}}" bindchange="onWeightSliderChange" activeColor="#FF7B54" style="flex:1;" />
        <view class="flex-row align-center" style="background:#FFF3E0; border-radius:16rpx; padding:12rpx 24rpx; width:180rpx; box-sizing:border-box;">
          <input type="digit" value="{{newWeight}}" bindinput="onWeightInput" style="flex:1; text-align:right; font-weight:bold; font-size:32rpx; color:#4A403A;" />
          <text class="font-bold" style="margin-left:8rpx; font-size:28rpx; color:#8F8377;">kg</text>
        </view>
      </view>
      <view class="flex-row gap-md" style="margin-top:48rpx;">
        <button class="btn-secondary flex-1" bindtap="closeWeightModal">{{i18n.cancel}}</button>
        <button class="btn-primary flex-1" bindtap="saveWeight">{{i18n.save}}</button>
      </view>
    </view>
  </view>

  <!-- Journal Modal -->
  <view wx:if="{{showJournalModal}}" class="modal-overlay" catchtap="closeJournalModal">
    <view class="modal-content card journal-modal-card" catchtap="noop">
      <view class="journal-modal-heading">
        <view class="journal-entry-icon">
          <image class="icon-img" lazy-load style="width:44rpx;height:44rpx;" src="{{ic.src('Book')}}" mode="aspectFit" />
        </view>
        <view class="flex-col">
          <text class="h3">{{journalEntryTitle || i18n.journal_today_title}}</text>
          <text class="journal-modal-date">{{selectedDateStr}}</text>
        </view>
      </view>

      <textarea
        class="journal-textarea"
        placeholder="{{i18n.journal_placeholder}}"
        value="{{journalText}}"
        maxlength="500"
        bindinput="onJournalTextInput"
      />

      <text class="font-bold" style="font-size:28rpx;">{{i18n.journal_moods}}</text>
      <view class="journal-mood-row">
        <view
          wx:for="{{journalMoodOptions}}"
          wx:key="id"
          class="journal-mood-pill {{selectedJournalMoods.indexOf(item.id) > -1 ? 'journal-mood-pill-active' : ''}}"
          bindtap="toggleJournalMood"
          data-id="{{item.id}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <view class="journal-custom-tag-box">
        <view class="journal-custom-tag-input-row">
          <input class="journal-custom-tag-input" placeholder="{{i18n.journal_custom_tag_placeholder}}" value="{{journalCustomTagInput}}" bindinput="onJournalCustomTagInput" />
          <view class="journal-custom-tag-add" bindtap="addJournalCustomTag">{{i18n.journal_custom_tag_add}}</view>
        </view>
        <view wx:if="{{selectedJournalCustomTags.length > 0}}" class="journal-tag-row">
          <view wx:for="{{selectedJournalCustomTags}}" wx:key="*this" class="journal-tag-pill journal-tag-pill-active" catchtap="removeJournalCustomTag" data-tag="{{item}}">
            <text>{{item}}</text>
            <text class="journal-tag-remove">×</text>
          </view>
        </view>
      </view>

      <view wx:if="{{journalImage}}" class="journal-photo-preview" bindtap="chooseJournalImage">
        <image src="{{journalImage}}" mode="aspectFill" class="journal-photo-img" />
        <view class="journal-photo-remove" catchtap="removeJournalImage">×</view>
      </view>
      <view wx:else class="journal-photo-placeholder" bindtap="chooseJournalImage">
        <image class="icon-img" lazy-load style="width:36rpx;height:36rpx;" src="{{ic.src('Camera')}}" mode="aspectFit" />
        <text>{{i18n.journal_photo_optional}}</text>
      </view>

      <view class="flex-row gap-md">
        <button class="btn-secondary flex-1" bindtap="closeJournalModal">{{i18n.cancel}}</button>
        <button class="btn-primary flex-1" bindtap="saveJournalEntry" disabled="{{!journalCanSave}}">{{i18n.save}}</button>
      </view>
    </view>
  </view>

  <!-- Journal Detail Modal -->
  <view wx:if="{{showJournalDetailModal}}" class="modal-overlay" catchtap="closeJournalDetail">
    <view class="modal-content card journal-detail-card" catchtap="noop">
      <view class="journal-note-header">
        <view class="flex-col">
          <text class="h3">{{i18n.journal_title}}</text>
          <text class="journal-modal-date">{{selectedJournalEntry.dateFormatted}}</text>
        </view>
        <view catchtap="closeJournalDetail">
          <image class="icon-img" lazy-load style="width:40rpx;height:40rpx;" src="{{ic.src('XCircle')}}" mode="aspectFit" />
        </view>
      </view>
      <image wx:if="{{selectedJournalEntry.image}}" src="{{selectedJournalEntry.image}}" mode="widthFix" class="journal-detail-image" />
      <text wx:if="{{selectedJournalEntry.text}}" class="journal-detail-text">{{selectedJournalEntry.text}}</text>
      <view wx:if="{{selectedJournalEntry.tagLabels.length > 0}}" class="journal-tag-row">
        <view wx:for="{{selectedJournalEntry.tagLabels}}" wx:for-item="tag" wx:key="*this" class="journal-tag-pill journal-tag-pill-active">
          <text>{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Export Loading Overlay -->
  <view wx:if="{{exportGenerating}}" class="modal-overlay">
    <view style="background:#fff;border-radius:40rpx;padding:60rpx 80rpx;display:flex;flex-direction:column;align-items:center;gap:32rpx;">
      <text style="font-size:36rpx;font-weight:700;color:#2C2C2C;">{{i18n.exporting || '生成中...'}}</text>
      <text style="font-size:24rpx;color:#8A8A8A;">{{i18n.export_drawing_hint}}</text>
    </view>
  </view>

  <!-- Export Preview Modal -->
  <view wx:if="{{showExportModal}}" class="modal-overlay export-preview-overlay" catchtap="closeExportModal">
    <!-- Scrollable Image Area -->
    <scroll-view scroll-y="true" class="export-preview-scroll" catchtap="closeExportModal">
      <view class="export-preview-content">
        <image
          wx:if="{{exportImageUrl}}"
          src="{{exportImageUrl}}"
          class="export-preview-image"
          mode="widthFix"
          bindlongpress="saveExportImage"
        />
        <text class="export-preview-tip">{{i18n.export_preview_hint}}</text>
        <view class="export-preview-actions" catchtap="noop">
          <button class="btn-secondary export-preview-close" bindtap="closeExportModal">{{i18n.close}}</button>
          <button class="btn-primary export-preview-save" bindtap="saveExportImage">{{i18n.save_to_album}}</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Stats Rules Modal (preview only, not exported) -->
  <view wx:if="{{showStatsRules}}" class="modal-overlay stats-rules-overlay" catchtap="closeStatsRules">
    <view class="modal-content card stats-rules-card" catchtap="noop">
      <view class="flex-row justify-between align-center">
        <text class="h3">{{i18n.stats_rules_title}}</text>
        <view class="stats-rule-close" catchtap="closeStatsRules">×</view>
      </view>
      <view class="stats-rule-list">
        <text>{{i18n.stats_rules_period}}</text>
        <text>{{i18n.stats_rules_compare}}</text>
        <text>{{i18n.stats_rules_care}}</text>
        <text>{{i18n.stats_rules_active}}</text>
        <text>{{i18n.stats_rules_hidden}}</text>
      </view>
      <button class="btn-primary" bindtap="closeStatsRules">{{i18n.got_it}}</button>
    </view>
  </view>

  <!-- Hidden canvas for export (off-screen) -->
  <canvas
    wx:if="{{exportCanvasVisible}}"
    type="2d"
    id="exportCanvas"
    style="position:fixed;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;"
  />
</view>
